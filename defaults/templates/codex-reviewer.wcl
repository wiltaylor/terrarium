description  = "Reviewer on Codex: reads versions and branches, comments on cards, does not push code."
harness      = "codex"
subscription = "openai-pro"
persona      = "worker"
restart      = "on-failure"

policy {
  targets = []
  mail_to = ["lead"]
}
