# Build context filter for docker/Dockerfile (BuildKit reads <Dockerfile>.dockerignore).
**
!Cargo.toml
!Cargo.lock
# The harness pins: crates/terrarium-core/build.rs reads it.
!harnesses.toml
!crates/**
# The cargo build env (bundled SQLite flags, TER-1314).
!.cargo/config.toml
!dashboard/**
dashboard/node_modules
dashboard/dist
!docker/entrypoint.sh
!docker/hot-swap.py
# The release public key of the updater's cosign check (/opt/terrarium/release).
!docker/release/**
# The packaged defaults: prompts and harness settings (/opt/terrarium/defaults).
!defaults/**
# The host installer: terrariumd embeds it (GET /install/host.sh).
!scripts/install-host.sh
# The release compose file: terrariumd embeds it (`terrariumd release-env-keys`).
!compose.yaml
**/target
