# Terrarium environment. Copy this file to .env and edit it:
#   cp .env.example .env
# `just up` makes .env from this file, with a fresh token, when .env is missing.
# Both just (set dotenv-load) and docker compose read .env.

# --- Required ------------------------------------------------------------

# The bearer token for the TCP API (dashboard and remote CLI). Use a long
# random value, for example the output of: openssl rand -hex 32
# The daemon turns its TCP listener off when the token is empty.
TERRARIUM_TOKEN=change-me

# --- Image and user ------------------------------------------------------

# The image name and tag that `just docker::image-build` makes and compose runs.
TERRARIUM_IMAGE=terrarium:dev

# The UID and GID of the `terrarium` user in the image. Set them to the owner
# of config/ and state/ on the host, so files in the bind mounts are yours.
# The justfile uses `id -u` and `id -g` when these are not set.
#TERRARIUM_UID=1000
#TERRARIUM_GID=1000

# --- Ports on the host ---------------------------------------------------

# The dashboard and API (container port 8080).
TERRARIUM_PORT=8080
# The artifact serving origin, separate from the dashboard (container port 8081, PLAN §15.2).
TERRARIUM_ARTIFACT_PORT=8081
# The port that host agents dial in to (container port 8082, PLAN §19).
# Without TLS, publish it on loopback only: TERRARIUM_HOST_PORT=127.0.0.1:8082
TERRARIUM_HOST_PORT=8082

# --- Host agent TLS (docs/host-protocol.md "TLS") ------------------------

# Run `just host::cert <name>` (the name that host agents dial) to write
# config/tls/host-cert.pem and host-key.pem and print the SHA-256 to pin with
# `server_fingerprint_sha256` in the host agent config. Paths are in the
# container. With both set, the dial-in speaks TLS on 0.0.0.0:8082.
#TERRARIUM_HOST_TLS_CERT=/etc/terrarium/tls/host-cert.pem
#TERRARIUM_HOST_TLS_KEY=/etc/terrarium/tls/host-key.pem

# The host agent dial-in listener. Compose passes it to the container.
# `auto` (the default): 0.0.0.0:8082 with TLS, 127.0.0.1:8082 without.
# Empty: no listener of its own. A plaintext
# bind to a non-loopback address logs a warning: the host token and all exec
# traffic then cross the network in clear text. For a host agent on the
# Docker host itself without TLS, set 0.0.0.0:8082 here and publish the port
# on loopback only (TERRARIUM_HOST_PORT=127.0.0.1:8082).
#TERRARIUM_HOST_LISTEN=auto

# --- URLs ----------------------------------------------------------------

# The dashboard URL as the operator opens it. Compose passes it to the
# container. The daemon puts it in the links of operator mail. `just
# host::install` takes the host agent's daemon_url from its host (port 8082)
# when TERRARIUM_HOST_DAEMON_URL is not set.
TERRARIUM_PUBLIC_URL=http://localhost:8080
# The host listener URL that `just host::install` writes as daemon_url in the
# host agent config, for example wss://terrarium.lan:8082. Only the install
# script reads it.
#TERRARIUM_HOST_DAEMON_URL=

# --- Logging -------------------------------------------------------------

# The log filter for terrariumd, in tracing EnvFilter syntax, for example
# `info`, `debug`, or `terrariumd=debug,info`.
RUST_LOG=info

# --- Local development (just daemon::run and the CLI, outside Docker) -----

# The TCP address for `just daemon::run`.
#TERRARIUM_DEV_LISTEN=127.0.0.1:8090
# The state directory for `just daemon::run`.
#TERRARIUM_DEV_STATE_DIR=target/dev-state
# The CLI talks to the Unix socket by default. Set these to use TCP instead.
#TERRARIUM_URL=http://localhost:8080
# The Unix socket of the daemon. The default is
# $XDG_RUNTIME_DIR/terrarium/api.sock, else /run/terrarium/api.sock.
#TERRARIUM_API_SOCKET=

# --- Daemon settings (terrariumd) -----------------------------------------

# terrariumd reads these. Compose does not pass them into the container: the
# image sets its own values (docker/Dockerfile). Outside Docker, `just` loads
# .env, so a value here applies to `just daemon::run`. The comment gives the
# default of terrariumd. `just daemon::run` sets some of them itself.

# The TCP address for the dashboard and the API.
#TERRARIUM_LISTEN=0.0.0.0:8080
# SQLite, workspaces, logs, and artifacts.
#TERRARIUM_STATE_DIR=/state
# The definitions: projects/, agents/, targets/, subscriptions/.
#TERRARIUM_CONFIG_DIR=/etc/terrarium
# The runner and control sockets. Default: $XDG_RUNTIME_DIR/terrarium, else /run/terrarium.
#TERRARIUM_RUNTIME_DIR=
# The prompt templates, <dir>/<name>.md.
#TERRARIUM_PROMPTS_DIR=/prompts
# `process`: one terrarium-runner process per agent; agents live through a daemon restart.
# `inprocess`: the runners run in the daemon and end with it (tests and development only).
#TERRARIUM_RUNNER_MODE=process
# The terrarium-runner binary for process mode. Default: next to terrariumd, else on PATH.
#TERRARIUM_RUNNER=
# The terrarium CLI that each sandbox binds. Default: next to terrariumd, else on PATH.
#TERRARIUM_CLI=
# `bwrap`, or `none` (no sandbox; development and tests only).
#TERRARIUM_SANDBOX=bwrap
# Pass --new-session to bwrap. Off by default: the harness then misses PTY resizes.
#TERRARIUM_SANDBOX_NEW_SESSION=false
# Local bare repos. A project repo with a URL under this dir (file:///repos/<name>.git)
# is bound read-write into the sandbox of each agent of that project.
#TERRARIUM_REPOS_DIR=/repos
# The work root: each agent's workspace is <dir>/<project>/<agent>. compose.yaml
# binds ./work here. A host agent on this machine attaches a workspace to a
# docker or vmlab target at /work/<project>/<agent>; set its `work_dir` to the
# host path of ./work (docs/host-protocol.md, "Workspaces").
#TERRARIUM_WORK_DIR=/work
# The most targets one project may have (409 conflict past it).
#TERRARIUM_MAX_TARGETS_PER_PROJECT=8
# The shared home of each harness, as a comma list. Default: /auth/<harness>.
#TERRARIUM_HARNESS_HOME=claude=/auth/claude,codex=/auth/codex,copilot=/auth/copilot,pi=/auth/pi
# The artifact serving origin. Empty: no listener of its own, and the
# dashboard port serves /a/... (security review F5).
#TERRARIUM_ARTIFACT_LISTEN=0.0.0.0:8081
# The artifact origin as a browser opens it, for signed artifact URLs, for
# example https://artifacts.example.com. Default: the host of the request
# with the port of TERRARIUM_ARTIFACT_LISTEN.
#TERRARIUM_ARTIFACT_PUBLIC_URL=
# `1` (or true, yes, on) takes the bearer token in `?token=` on a WebSocket
# upgrade, with a warning in the log. Clients send it as the subprotocol
# `bearer.<token>`. Default: `0`, the daemon refuses `?token=`.
#TERRARIUM_WS_QUERY_TOKEN=0
# The life of a dashboard session cookie: seconds, or a number with s, m, h, or d.
#TERRARIUM_SESSION_TTL=12h
# The ssh binary for ssh targets.
#TERRARIUM_SSH=ssh
# Trust the X-Terrarium-Agent header on the Unix socket. Any local caller can
# then act as any agent. Tests only.
#TERRARIUM_INSECURE_AGENT_HEADER=false

# Mailbox and trash
# Agent-to-agent replies on one thread with no human message before the thread pauses and the operator is mailed.
#TERRARIUM_MAIL_LOOP_LIMIT=6
# Days a removed agent's directory and workspace stay under <state>/trash before the daily prune removes them.
#TERRARIUM_TRASH_DAYS=7
