# Terrarium environment. Copy this file to .env and edit it:
#   cp .env.example .env
# `just up` makes .env from this file, with a fresh token, when .env is missing.
# Both just (set dotenv-load) and docker compose read .env.

# --- Required ------------------------------------------------------------

# The bearer token for the TCP API (dashboard and remote CLI). Use a long
# random value, for example the output of: openssl rand -hex 32
# The daemon turns its TCP listener off when the token is empty.
TERRARIUM_TOKEN=change-me

# --- Image and user ------------------------------------------------------

# The image name and tag that `just docker::image-build` makes and compose runs.
TERRARIUM_IMAGE=terrarium:dev

# The UID and GID of the `terrarium` user in the image. Set them to the owner
# of config/ and state/ on the host, so files in the bind mounts are yours.
# The justfile uses `id -u` and `id -g` when these are not set.
#TERRARIUM_UID=1000
#TERRARIUM_GID=1000

# --- Ports on the host ---------------------------------------------------

# The dashboard and API (container port 8080).
TERRARIUM_PORT=8080
# The artifact serving origin, separate from the dashboard (container port 8081, PLAN §15.2).
TERRARIUM_ARTIFACT_PORT=8081
# The port that host agents dial in to (container port 8082, PLAN §19).
TERRARIUM_HOST_PORT=8082

# --- URLs ----------------------------------------------------------------

# The URL that browsers and host agents use to reach the daemon. Preview links
# in mail and wiki pages use it.
TERRARIUM_PUBLIC_URL=http://localhost:8080

# --- Logging -------------------------------------------------------------

# The log filter for terrariumd, in tracing EnvFilter syntax, for example
# `info`, `debug`, or `terrariumd=debug,info`.
RUST_LOG=info

# --- Local development (just daemon::run and the CLI, outside Docker) -----

# The TCP address for `just daemon::run`.
#TERRARIUM_DEV_LISTEN=127.0.0.1:8090
# The state directory for `just daemon::run`.
#TERRARIUM_DEV_STATE_DIR=target/dev-state
# The CLI talks to the Unix socket by default. Set these to use TCP instead.
#TERRARIUM_URL=http://localhost:8080
# The Unix socket of the daemon. The default is
# $XDG_RUNTIME_DIR/terrarium/api.sock, else /run/terrarium/api.sock.
#TERRARIUM_API_SOCKET=
