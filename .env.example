# Terrarium environment. Copy this file to .env and edit it:
#   cp .env.example .env
# `just up` makes .env from this file, with a fresh token, when .env is missing.
# Both just (set dotenv-load) and docker compose read .env.

# --- Required ------------------------------------------------------------

# The bearer token for the TCP API (dashboard and remote CLI). Use a long
# random value, for example the output of: openssl rand -hex 32
# The daemon turns its TCP listener off when the token is empty.
TERRARIUM_TOKEN=change-me

# --- Operator password ---------------------------------------------------

# The operator password for the dashboard login and `terrarium login`. The
# daemon keeps only an Argon2id hash in state/operator.password. The best way
# to set it: `docker compose exec terrarium terrariumd password set`.
# For a first start with no prompt, set it here (12 characters or more). The
# daemon sets it at the start when no password exists, and ignores it after
# that, and starts again without it, so no child process sees it. Remove it
# from .env after the first start.
#TERRARIUM_PASSWORD=

# --- Image and user ------------------------------------------------------

# The image name and tag that `just docker::image-build` makes and compose runs.
TERRARIUM_IMAGE=terrarium:dev

# The UID and GID of the `terrarium` user in the image. Set them to the owner
# of config/ and state/ on the host, so files in the bind mounts are yours.
# The justfile uses `id -u` and `id -g` when these are not set.
#TERRARIUM_UID=1000
#TERRARIUM_GID=1000

# The git ref that the image build stamps into the binaries' version
# (`terrarium version`, `<version>+<ref>`). `just docker::*` takes it from
# git and a deploy from src/.deployed-ref, so do not set it here.
#TERRARIUM_GIT_REF=

# The dir that holds the bind-mount sources of compose.yaml (config/, state/,
# tools/, work/, ...). Unset: the dir of compose.yaml, so a dev checkout uses
# its own dirs. `just deploy::server` sets it in <dir>/terrarium-compose to
# the install dir, so the data is not in <dir>/src. Do not set it here.
#TERRARIUM_DATA_DIR=

# --- Ports on the host ---------------------------------------------------

# The dashboard and API (container port 8080).
TERRARIUM_PORT=8080
# The artifact serving origin, separate from the dashboard (container port 8081, PLAN §15.2).
TERRARIUM_ARTIFACT_PORT=8081
# The port that host agents dial in to (container port 8082, PLAN §19).
# Without TLS, publish it on loopback only: TERRARIUM_HOST_PORT=127.0.0.1:8082
# (`just deploy::...` does this in a new .env, with TERRARIUM_HOST_LISTEN and
# TERRARIUM_HOST_DAEMON_URL below).
TERRARIUM_HOST_PORT=8082
# The ingest listener for webhooks from GitHub, Forgejo, or a script
# (container port 8083, docs/api.md §20). It serves only /hooks/... and
# /healthz, so you can open it to a forge and keep the API port closed.
TERRARIUM_INGEST_PORT=8083

# --- Host agent TLS (docs/host-protocol.md "TLS") ------------------------

# Run `just host::cert <name>` (the name that host agents dial) to write
# config/tls/host-cert.pem and host-key.pem and print the SHA-256 to pin with
# `server_fingerprint_sha256` in the host agent config. Paths are in the
# container. With both set, the dial-in speaks TLS on 0.0.0.0:8082.
#TERRARIUM_HOST_TLS_CERT=/etc/terrarium/tls/host-cert.pem
#TERRARIUM_HOST_TLS_KEY=/etc/terrarium/tls/host-key.pem

# The host agent dial-in listener. Compose passes it to the container.
# `auto` (the default): 0.0.0.0:8082 with TLS, 127.0.0.1:8082 without.
# Empty: no listener of its own. A plaintext
# bind to a non-loopback address logs a warning: the host token and all exec
# traffic then cross the network in clear text. For a host agent on the
# Docker host itself without TLS, set 0.0.0.0:8082 here and publish the port
# on loopback only (TERRARIUM_HOST_PORT=127.0.0.1:8082).
#TERRARIUM_HOST_LISTEN=auto

# --- URLs ----------------------------------------------------------------

# The dashboard URL as the operator opens it. Compose passes it to the
# container. The daemon puts it in the links of operator mail, and the host
# installer (GET /install/host.sh) downloads from it. Set it to a name that
# your hosts can reach, for example http://terrarium.lan:8080. The installer
# and `just host::install` take the host agent's daemon_url from its host
# (port 8082) when TERRARIUM_HOST_DAEMON_URL is not set.
TERRARIUM_PUBLIC_URL=http://localhost:8080
# The host listener URL that the host installer and `just host::install`
# write as daemon_url in the host agent config, for example
# wss://terrarium.lan:8082. Set it when the published port is not 8082, or
# when a proxy is in front. Compose passes it to the container.
#TERRARIUM_HOST_DAEMON_URL=
# The ingest listener as a forge reaches it, for the hook URL that
# `terrarium event source add` prints, for example
# https://hooks.example.com. Compose passes it to the container. Default:
# made from TERRARIUM_INGEST_ADDR (http://localhost:8083).
#TERRARIUM_INGEST_PUBLIC_URL=
# Which addresses a webhook action of a trigger can reach (docs/api.md
# §19.5): allow (the default: the LAN and this host too) or deny (public
# addresses only: no loopback, link-local, private, or unique-local
# address, and not the daemon's own ports). Set deny on a public
# deployment where untrusted people are project_admins. Compose passes it
# to the container.
#TERRARIUM_WEBHOOK_PRIVATE=allow
# The git proxy (PLAN §9, "The git proxy", docs/api.md §5.1): agent
# checkouts of a proxied repo (push_via = proxy, or an https repo with a token
# and push_deny) fetch and push through it, so push_deny is a hard rule and the
# forge token never enters the sandbox. Keep it on loopback: the sandboxes share
# the daemon's network. Empty: no proxy, and every repo is direct.
#TERRARIUM_GIT_PROXY_LISTEN=127.0.0.1:8084

# --- Logging -------------------------------------------------------------

# The log filter for terrariumd, in tracing EnvFilter syntax, for example
# `info`, `debug`, or `terrariumd=debug,info`.
RUST_LOG=info

# --- Local development (just daemon::run and the CLI, outside Docker) -----

# The tools dir of `just daemon::run`: the daemon installs the harness pins
# of harnesses.toml here and puts its bin/ first on PATH. Default: ./tools
# in the checkout, the same dir that the stack binds at /opt/terrarium/tools.
# Set it empty to use the harnesses on your PATH as they are. (The image
# sets its own value; compose does not pass this one into the container.)
#TERRARIUM_TOOLS_DIR=

# The TCP address for `just daemon::run`.
#TERRARIUM_DEV_LISTEN=127.0.0.1:8090
# The state directory for `just daemon::run`.
#TERRARIUM_DEV_STATE_DIR=target/dev-state
# The CLI talks to the Unix socket by default. Set these to use TCP instead.
#TERRARIUM_URL=http://localhost:8080
# The Unix socket of the daemon. The default is
# $XDG_RUNTIME_DIR/terrarium/api.sock, else /run/terrarium/api.sock.
#TERRARIUM_API_SOCKET=

# --- Daemon settings (terrariumd) -----------------------------------------

# terrariumd reads these. Compose does not pass them into the container: the
# image sets its own values (docker/Dockerfile). Outside Docker, `just` loads
# .env, so a value here applies to `just daemon::run`. The comment gives the
# default of terrariumd. `just daemon::run` sets some of them itself.

# The TCP address for the dashboard and the API.
#TERRARIUM_LISTEN=0.0.0.0:8080
# SQLite, workspaces, logs, and artifacts.
#TERRARIUM_STATE_DIR=/state
# The definitions: projects/, agents/, targets/, subscriptions/.
#TERRARIUM_CONFIG_DIR=/etc/terrarium
# The runner and control sockets. Default: $XDG_RUNTIME_DIR/terrarium, else /run/terrarium.
#TERRARIUM_RUNTIME_DIR=
# The prompt templates and personas, <dir>/<name>.md. Default: the prompts/ of
# the config repo.
#TERRARIUM_PROMPTS_DIR=
# The config repo (PLAN §8.3): prompts/, harness/<harness>/, and export/, in
# git. Compose binds ./config/terrarium here. It never holds a secret.
#TERRARIUM_CONFIG_REPO=/config/terrarium
# The packaged defaults that the daemon copies into the config repo at start.
#TERRARIUM_DEFAULTS_DIR=/opt/terrarium/defaults
# The config repo auto-sync: off (default), pull (fetch and merge; export/
# changes wait for `terrarium admin config pull --apply`), or sync (commit
# with the secret scan, fetch, merge, push). It runs every interval.
#TERRARIUM_CONFIG_SYNC=off
#TERRARIUM_CONFIG_SYNC_INTERVAL=15m
# `process`: one terrarium-runner process per agent; agents live through a daemon restart.
# `inprocess`: the runners run in the daemon and end with it (tests and development only).
#TERRARIUM_RUNNER_MODE=process
# The terrarium-runner binary for process mode. Default: next to terrariumd, else on PATH.
#TERRARIUM_RUNNER=
# The terrarium CLI that each sandbox binds. Default: next to terrariumd, else on PATH.
#TERRARIUM_CLI=
# `bwrap`, or `none` (no sandbox; development and tests only).
#TERRARIUM_SANDBOX=bwrap
# Pass --new-session to bwrap. Off by default: the harness then misses PTY resizes.
#TERRARIUM_SANDBOX_NEW_SESSION=false
# Local bare repos. A project repo with a URL under this dir (file:///repos/<name>.git)
# is bound read-write into the sandbox of each agent of that project.
#TERRARIUM_REPOS_DIR=/repos
# The work root: each agent's workspace is <dir>/<project>/<agent>. compose.yaml
# binds ./work here. A host agent on this machine attaches a workspace to a
# docker or vmlab target at /work/<project>/<agent>; set its `work_dir` to the
# host path of ./work (docs/host-protocol.md, "Workspaces").
#TERRARIUM_WORK_DIR=/work
# The most targets one project may have (409 conflict past it).
#TERRARIUM_MAX_TARGETS_PER_PROJECT=8
# The shared home of each harness, as a comma list. Default: /auth/<harness>.
#TERRARIUM_HARNESS_HOME=claude=/auth/claude,codex=/auth/codex,copilot=/auth/copilot,pi=/auth/pi
# The artifact serving origin. Empty: no listener of its own, and the
# dashboard port serves /a/... (security review F5).
#TERRARIUM_ARTIFACT_LISTEN=0.0.0.0:8081
# The artifact origin as a browser opens it, for signed artifact URLs, for
# example https://artifacts.example.com. Default: the host of the request
# with the port of TERRARIUM_ARTIFACT_LISTEN.
#TERRARIUM_ARTIFACT_PUBLIC_URL=
# The ingest listener (webhooks, docs/api.md §20). Unset or empty: off.
# Compose sets 0.0.0.0:8083 in the container.
#TERRARIUM_INGEST_ADDR=127.0.0.1:8093
# `1` (or true, yes, on) takes the bearer token in `?token=` on a WebSocket
# upgrade, with a warning in the log. Clients send it as the subprotocol
# `bearer.<token>`. Default: `0`, the daemon refuses `?token=`.
#TERRARIUM_WS_QUERY_TOKEN=0
# The life of a dashboard session cookie: seconds, or a number with s, m, h, or d.
# The daemon renews the cookie when a request comes past half its life.
#TERRARIUM_SESSION_TTL=30d
# The longest life of a dashboard session through its renewals, from the login.
#TERRARIUM_SESSION_MAX_AGE=90d
# The life of a CLI session token (`terrarium login`). It is not renewed.
#TERRARIUM_CLI_SESSION_TTL=90d
# The ssh binary for ssh targets.
#TERRARIUM_SSH=ssh
# Trust the X-Terrarium-Agent header on the Unix socket. Any local caller can
# then act as any agent. Tests only.
#TERRARIUM_INSECURE_AGENT_HEADER=false
# The harness auto-update: a background check asks npm for each harness and
# installs a newer release (majors too) into a new version dir. Running agents
# keep their version until their next start or wake. A pinned harness is never
# updated (`terrarium admin harness pin <name> [version]`, `unpin <name>`).
# `daily`, `off`, or a duration of 1h or more such as 6h.
#TERRARIUM_HARNESS_AUTO_UPDATE=daily
# An Inbox mail for each update that the auto-update installs, with the rollback
# command: `off` (no mail) or `on`. The dashboard (Settings > Subscriptions) shows
# each update with both values. A failed install always sends one mail for each
# failed version.
#TERRARIUM_HARNESS_UPDATE_MAIL=off

# --- Backups (docs/api.md §32) -------------------------------------------
# A backup is a zip file. IT HOLDS EVERY SECRET of the daemon (secrets.key,
# the database, the plan logins). The dir; empty: /state/backups.
#TERRARIUM_BACKUP_DIR=
# The scheduled backup: off, daily, weekly, or a duration of 1h or more.
#TERRARIUM_BACKUP_SCHEDULE=off
# A full backup when the newest full backup is older than this; else a diff.
#TERRARIUM_BACKUP_FULL_EVERY=7d
# The full backups to keep (with their diffs). Older ones are deleted.
#TERRARIUM_BACKUP_KEEP=4
# Add the agent workspaces (/work) to the scheduled backups: on or off.
#TERRARIUM_BACKUP_WORK=off
# Seal the scheduled backups with the first line of this file (a path in
# the container, for example under /state, mode 0600).
#TERRARIUM_BACKUP_PASSPHRASE_FILE=
# Plan accounts (PLAN §16.3): when a probe finds an account at 100 percent, move
# each agent with an account pool to the next account with room. `off` keeps
# the agents on the full account, with a hold until the reset.
#TERRARIUM_AUTO_SWAP=on
# The question guard (PLAN §8.4): a member whose turn ends with a question in
# plain text, and that sent no mail, becomes `blocked`, and its lead (or the
# operator) gets the question by mail. `off` turns the check off.
#TERRARIUM_QUESTION_GUARD=on

# Mailbox and trash
# Agent-to-agent replies on one thread with no human message before the thread pauses and the operator is mailed.
#TERRARIUM_MAIL_LOOP_LIMIT=6
# Days a removed agent's directory and workspace stay under <state>/trash before the daily prune removes them.
#TERRARIUM_TRASH_DAYS=7

# Card files (docs/api.md §8.4): the most bytes in one file, and in all the
# stored versions of the files of one card. Bytes, or a size such as 512K.
#TERRARIUM_CARD_FILE_MAX_BYTES=10M
#TERRARIUM_CARD_FILES_MAX_BYTES=50M

# The most bytes in a system prompt: an agent's system_prompt and a persona
# file of system-prompts/. An agent with a persona over it does not start.
# Bytes, or a size such as 64K. At most 96K.
#TERRARIUM_SYSTEM_PROMPT_MAX=32K

# Agent lifecycle (PLAN §18)
# An agent at rest (idle or waiting) this long stops by itself; mail, a turn,
# a card, or a nudge wakes it again. A duration such as 10m or 1h30m, or `off`.
# An agent's own `idle_stop` wins over it.
#TERRARIUM_IDLE_STOP=10m
# Auto compact (PLAN §18): the daemon types the harness's `/compact` into an
# agent at rest. Each compaction is one model call, so both are off. An
# agent's own `compact_on_idle` and `compact_max_age` win over them.
# `on`: compact the session at the idle stop, before the stop.
#TERRARIUM_COMPACT_ON_IDLE=off
# A duration such as 24h: compact a session that is older at its next rest.
#TERRARIUM_COMPACT_MAX_AGE=off

# Waits and runs (PLAN §12d)
# The timeout of an agent, process, or card wait, and of `terrarium run`, that names none.
#TERRARIUM_WAIT_DEFAULT_TIMEOUT=24h
# The longest timeout of a wait or a run, and the longest time wait.
#TERRARIUM_WAIT_MAX_TIMEOUT=7d
