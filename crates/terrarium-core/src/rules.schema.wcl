// The schema of a project's board rules: `rules.wcl` (TER-162, TER-166).
//
// The daemon ships this file and checks each rules file against it when
// it loads the file and on each edit. A rules file holds plain data only:
// literal values (no let, call, function, or reference), and no
// `import`, `type`, `union`, `symbol_set`, `namespace`, or `use`. The
// daemon also checks what a schema cannot say: the rule names are
// unique, a rule has at least one verb, the `when` paths, the
// `{{...}}` templates, and the columns (`@<role>` or a column name of
// the project's board).
//
// A rule with only `enabled = false` (no `on`, no verb) turns off the
// rule of that name of the built-in pack (`board_flow = rules`).
//
// A rule reacts to an event of the log (`on`, kind globs) when every
// `when` holds, and runs its verbs in the order of the file:
//
//   rule "validate-pass" {
//     on = ["job.verdict"]
//     when "data.verdict" { eq = "passed" }
//     card_label  { remove = ["validation:running", "validation:queued"] }
//     card_move   { to = "@review"  comment = "{{job.end_comment}}" }
//     card_assign { who = "none" }
//   }

@document
type Rules {
  @children("rule") rules: list<Rule>
}

@block("rule")
type Rule {
  @inline(0) name: utf8
  description: utf8?
  // Absent: true.
  enabled: bool?
  // Event kind globs, for example `card` or `job.*`. A disabled rule
  // may leave it out.
  on: list<utf8>?
  // The most runs of the rule in one hour.
  max_per_hour: i64?
  @children("when") when: list<When>
  // Conditions on the current state, checked when a run starts.
  @children("if_card") if_card: list<IfCard>
  @children("if_job") if_job: list<IfJob>

  // The verbs, run in the order of the file.
  @children("version_cut") version_cut: list<VersionCut>
  @children("group_open") group_open: list<GroupOpen>
  @children("group_add") group_add: list<GroupAdd>
  @children("group_remove") group_remove: list<GroupRemove>
  @children("group_status") group_status: list<GroupStatus>
  @children("group_close") group_close: list<GroupClose>
  @children("card_move") card_move: list<CardMove>
  @children("card_wait_action") card_wait_action: list<CardWaitAction>
  @children("card_label") card_label: list<CardLabel>
  @children("card_comment") card_comment: list<CardComment>
  @children("card_assign") card_assign: list<CardAssign>
  @children("review_start") review_start: list<ReviewStart>
  @children("card_prepend") card_prepend: list<CardPrepend>
  @children("mail") mail: list<Mail>
  @children("card_blocked_mail") card_blocked_mail: list<CardBlockedMail>
  @children("card_done_mail") card_done_mail: list<CardDoneMail>
  @children("job_queue") job_queue: list<JobQueue>
  @children("job_cancel") job_cancel: list<JobCancel>
  @children("job_rerun") job_rerun: list<JobRerun>
  @children("job_split") job_split: list<JobSplit>
  @children("job_fix") job_fix: list<JobFix>
  @children("agent_park") agent_park: list<AgentPark>
  @children("agent_unpark") agent_unpark: list<AgentUnpark>
  @children("agent_end") agent_end: list<AgentEnd>
  @children("script") script: list<Script>
}

// Group keys are scoped to the project. Membership uses the event's card.
// done_when names a column or role. eta is a duration or "jobs".
@block("group_open")
type GroupOpen {
  key: utf8
  title: utf8
  column: utf8
  done_when: utf8
  eta: utf8?
  close_after: utf8?
}

@block("group_add")
type GroupAdd { key: utf8 }

// Freeze eligible accepted version:vnext cards when either threshold is met.
@block("version_cut")
type VersionCut {
  min_cards: i64
  max_wait_minutes: i64
}

@block("group_remove")
type GroupRemove { key: utf8 }

@block("group_status")
type GroupStatus {
  key: utf8
  text: utf8?
  eta: utf8?
  step: utf8?
  state: utf8?
}

@block("group_close")
type GroupClose {
  key: utf8
  comment: utf8?
  all_done: bool?
}

// One condition on the event: `project`, `kind`, `actor`, `summary`, or
// `data.<dotted path>`, with exactly one of the compares.
@block("when")
type When {
  @inline(0) path: utf8
  eq: utf8?
  ne: utf8?
  glob: utf8?
  one_of: list<utf8>?
}

// A condition on the current state of the run's card, checked when the
// run starts (after the earlier runs of the same card). Each field that
// is set must hold. A rule with an `if_card` does not run for an event
// without a card.
@block("if_card")
type IfCard {
  // Belongs to an open group whose key starts with this prefix.
  group_key_prefix: utf8?
  // In one of these columns (`@<role>` or a column name).
  column: list<utf8>?
  // In none of these columns.
  not_column: list<utf8>?
  // Has every one of these labels.
  has_labels: list<utf8>?
  // Has at least one of these labels.
  any_labels: list<utf8>?
  // Has none of these labels.
  lacks_labels: list<utf8>?
  assigned: bool?
  archived: bool?
}

// A condition on the current state of the event's job (`data.id` of a
// `job` event, `data.job` of a `job.verdict` event). A rule with an
// `if_job` does not run for another event. `state`: queued, running,
// passed, failed, cancelled. `outcome`: red, conflict, error, or none.
// `split`: the job is a half of a split batch. `batch`: two or more
// cards of the job merged (did not conflict). `rerun`: a rerun of the job
// is queued or ran. `halves`: the job was split in halves.
@block("if_job")
type IfJob {
  state: list<utf8>?
  outcome: list<utf8>?
  split: bool?
  batch: bool?
  rerun: bool?
  halves: bool?
}

// Move the card of the event. `to` and `from` name a column: `@<role>`
// or a column name. `from`: only when the card is in one of them.
// `position`: `top` or `bottom` (absent: bottom).
@block("card_move")
type CardMove {
  to: utf8
  from: list<utf8>?
  comment: utf8?
  position: utf8?
}

@block("card_wait_action")
type CardWaitAction {}

// `remove` takes globs (`by:*`). A label in `add` stays.
@block("card_label")
type CardLabel {
  add: list<utf8>?
  remove: list<utf8>?
}

@block("card_comment")
type CardComment {
  text: utf8
}

// Exactly one of: `who` (an agent name or `none`); `template` (a new bound
// agent from this template claims the card); `templates` (entries
// `<label>=<template>`: the card's one matching label picks the template).
// A new agent needs `owner`, the project admin whose spawn rights and caps
// are used. `from`: take the top eligible cards of this column, up to
// `limit` (1); else the run's card. The column with the role `working`
// must have a free WIP slot (the claim lands there).
@block("card_assign")
type CardAssign {
  who: utf8?
  template: utf8?
  templates: list<utf8>?
  owner: utf8?
  from: utf8?
  limit: i64?
}

// A review agent for a card in the review column (TER-1214): a new bound
// agent from `template` (default `card-review`) reviews the card and posts
// `Review verdict: accept` or `Review verdict: changes`, which moves it
// to `merge_queue` or `ready`. `owner` is the project admin whose spawn
// rights and caps are used. `max_rounds` (default 3, at most 10): after
// that many rounds the card stays in review and the owner gets one mail.
// `from`: the review column, for a rule with no card (a timer); else the
// run's card.
@block("review_start")
type ReviewStart {
  template: utf8?
  owner: utf8
  max_rounds: i64?
  from: utf8?
}

// Put text at the top of the card body.
@block("card_prepend")
type CardPrepend {
  text: utf8
}

@block("mail")
type Mail {
  to: list<utf8>
  subject: utf8
  body: utf8?
}

// The blocked notice of a move to the blocked column, as the coded flow
// sends it: from `system` to the operator and the card's creator, not to
// the mover. Only on the `moved` event of such a move.
@block("card_blocked_mail")
type CardBlockedMail {}

// The done notice of a move to `done`, as the coded flow sends it: to the
// participants of each linked thread. Only on the `moved` event of such a
// move.
@block("card_done_mail")
type CardDoneMail {}

// `kind`: `validate`, `merge`, or `batch`. A batch takes the cards of the
// column `from` in board order, at most `limit` (absent: all of them).
// `min_cards`: the batch goes only when at least that many cards wait,
// or, with `max_wait_minutes`, when the first card that waits has waited
// that long. The engine checks that time itself and runs the rule then
// (a `rule.timer` event).
@block("job_queue")
type JobQueue {
  kind: utf8
  from: utf8?
  limit: i64?
  min_cards: i64?
  max_wait_minutes: i64?
}

@block("job_cancel")
type JobCancel {}

// Queue the job of the event again, while its attempt is under
// `max_attempts` (absent: 2).
@block("job_rerun")
type JobRerun {
  max_attempts: i64?
}

// Split a red batch of the event in halves. `after_fixes`: only when the
// group had at least that many fix cards of earlier jobs (`job_fix`).
@block("job_split")
type JobSplit {
  after_fixes: i64?
}

// Open one fix card for the red merge job of the event: in the column
// `to` (absent: `@ready`), with the label `merge-fix:<job>` and the
// `labels`, a link to each card of the job, and the failure block in its
// body. Nothing when the job is not red, when an open card has that label
// already, or when the group had `max` fix cards of earlier jobs.
@block("job_fix")
type JobFix {
  to: utf8?
  labels: list<utf8>?
  max: i64?
}

// `reason`: the park reason (absent: `rule <name>`).
@block("agent_park")
type AgentPark {
  reason: utf8?
}

// `turn`: the text of the turn that wakes the agent.
@block("agent_unpark")
type AgentUnpark {
  turn: utf8?
}

// `outcome`: `done` or `cancelled`. `result`: the result for the owner
// (absent: `the rule <name> ended it`).
@block("agent_end")
type AgentEnd {
  outcome: utf8
  result: utf8?
}

// A wscript program for what WCL cannot say (TER-173). It runs with fuel
// (wscript instructions, default 100000, at most 10000000), a memory
// limit and a wall-clock limit, in a child process with no file, process,
// network or environment access. `use rule`: `rule::get(name)` reads the
// value of a placeholder (`event.kind`, `event.data.x`, `card.column`,
// `card.labels`, `job.state`, `group.key`, `rule.name`) as an
// `Option[string]`, and `rule::quote(text)` writes a text as a WCL
// string. `fn main() -> string` returns verb blocks of this file (for
// example `card_move { to = "@review" }`); they run in place of the step,
// with the same checks. Write the source as a raw heredoc (`<<'WS'`).
// In a wscript string, `{x}` is a hole: write a brace as `{{` or `}}`.
@block("script")
type Script {
  source: utf8
  fuel: i64?
}
